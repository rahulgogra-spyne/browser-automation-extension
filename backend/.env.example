OPENAI_API_KEY=
# Any chat model that supports structured outputs (JSON schema, strict mode).
OPENAI_MODEL=gpt-4.1-mini

# Shared secret the extension sends as x-api-key (set the same value in the
# extension's Settings page). Leave empty only for local use.
EXTENSION_API_KEY=

PORT=8787
# 127.0.0.1 = only this computer can call the server. Use 0.0.0.0 to serve
# other machines, and put it behind HTTPS.
HOST=127.0.0.1

# Upper bound on the page text sent to the model per capture.
MAX_PROMPT_CHARS=60000

# --- CRM mapping agent -------------------------------------------------------
# Model the agent uses to locate data on CRM pages (defaults to OPENAI_MODEL).
MAPPER_MODEL=
# "off" disables the daily re-mapping (failure-triggered re-maps still run).
MAPPER_SCHEDULE=on
MAP_INTERVAL_HOURS=24
# Browser the agent drives: chrome or msedge (an installed one is used).
MAPPER_BROWSER=
# Where the CRM structure config and the CRM registry live.
CRM_CONFIG_PATH=
CRM_SITES_PATH=

# Sign-in for the mock CDK CRM (mock-crms/). Real CRMs get their own
# variables, named in config/crm-sites.json.
MOCK_CDK_USER=demo.sales
MOCK_CDK_PASSWORD=mock-crm-2026

{
  "name": "lead-capture-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Extraction server for the Spyne Lead Capture extension: AI page extraction, the CRM structure config, and the CRM mapping agent.",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "map": "node --env-file-if-exists=.env src/mapper/cli.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "openai": "^7.23.0",
    "playwright-core": "^1.63.0"
  }
}

{
  "manifest_version": 3,
  "name": "Spyne CRM Capture",
  "version": "1.1.0",
  "description": "Capture every record of a mapped CRM into daily CSV files.",
  "minimum_chrome_version": "121",
  "action": {
    "default_title": "Open the capture window",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": [
    "scripting",
    "storage",
    "unlimitedStorage",
    "downloads",
    "webNavigation",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
